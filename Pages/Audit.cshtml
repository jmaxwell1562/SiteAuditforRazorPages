@page
@model AuditApp.Pages.AuditModel
@{
    ViewData["Title"] = "Site Audit";
    var hasReports = Model.LatestReport != null;
}

<style>
    :root {
        --wsu-crimson: #981e32;
        --wsu-crimson-deep: #7f182b;
        --wsu-dark: #2a3038;
        --wsu-navy: #23364a;
        --wsu-gold: #d8b56a;
        --wsu-sand: #f4f1ed;
        --wsu-cream: #fbf8f3;
        --wsu-border: #dbd1c7;
        --wsu-ink: #1f2329;
        --wsu-muted: #5c6773;
        --wsu-success: #1f7a3a;
        --wsu-warning: #a56609;
        --wsu-error: #b11e3a;
        --wsu-info: #355d8c;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        color: var(--wsu-ink);
        background:
            radial-gradient(circle at top right, rgba(152, 30, 50, 0.14), transparent 24%),
            linear-gradient(180deg, #f2ebe3 0, #faf7f2 180px, #ffffff 420px);
        font-family: Segoe UI, Tahoma, sans-serif;
    }

    .wsu-g-header__wrapper {
        background: #ffffff;
        border-bottom: 1px solid rgba(31, 35, 41, 0.12);
        box-shadow: 0 14px 32px rgba(31, 35, 41, 0.14);
    }

    .wsu-g-header {
        max-width: 1280px;
        margin: 0 auto;
        padding: 18px 20px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .wsu-g-header__logo-link {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        color: #4f5963;
        text-decoration: none;
        min-width: 0;
    }

    .wsu-g-header__logo-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 78px;
        height: 78px;
        padding: 10px;
        border-radius: 20px;
        background: rgba(152, 30, 50, 0.08);
        color: var(--wsu-crimson);
        box-shadow: inset 0 0 0 1px rgba(152, 30, 50, 0.14);
    }

    .wsu-g-header__logo-svg {
        width: 54px;
        height: 54px;
        display: block;
    }

    .wsu-g-header__logo-svg .st0 {
        fill: currentColor;
    }

    .wsu-g-header__logo-text {
        display: grid;
        gap: 4px;
        min-width: 0;
    }

    .wsu-g-header__logo-kicker {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 11px;
        opacity: 0.78;
    }

    .wsu-g-header__logo-title {
        font-size: 28px;
        font-weight: 700;
        line-height: 1.05;
    }

    .wsu-g-header__logo-subtitle {
        font-size: 13px;
        color: #5c6773;
        max-width: 44ch;
    }

    .sticky {
        display: flex;
        align-items: center;
    }

    .stickyHoverButton {
        border: 1px solid rgba(31, 35, 41, 0.16);
        border-radius: 999px;
        background: #ffffff;
        color: #4f5963;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 12px 18px;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.2s ease;
    }

    .stickyHoverButton:hover {
        background: #f6f1ec;
        transform: translateY(-1px);
    }

    .audit-shell {
        padding: 24px 20px 48px;
    }

    .audit-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    .audit-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
        gap: 22px;
        margin-bottom: 24px;
    }

    .hero-card,
    .hero-side,
    .audit-form,
    .status-panel,
    .report-card {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid var(--wsu-border);
        border-radius: 20px;
        box-shadow: 0 20px 44px rgba(31, 35, 41, 0.08);
    }

    .hero-card {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 243, 236, 0.98));
        color: var(--wsu-ink);
        padding: 28px;
        position: relative;
        overflow: hidden;
        border-top: 6px solid var(--wsu-crimson);
    }

    .hero-card::after {
        content: "";
        position: absolute;
        inset: auto -90px -150px auto;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, rgba(216, 181, 106, 0.34), transparent 68%);
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(152, 30, 50, 0.08);
        color: var(--wsu-crimson);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 18px;
    }

    .hero-title {
        margin: 0;
        font-size: 38px;
        line-height: 1.02;
        color: var(--wsu-navy);
        max-width: 12ch;
    }

    .hero-title strong {
        color: var(--wsu-crimson);
    }

    .hero-copy {
        margin: 16px 0 0;
        color: var(--wsu-muted);
        font-size: 16px;
        line-height: 1.7;
        max-width: 60ch;
    }

    .hero-side {
        padding: 24px;
        display: grid;
        gap: 16px;
        align-content: start;
        background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(250,245,239,0.98));
    }

    .hero-side h2,
    .audit-form h2,
    .status-panel h2,
    .reports-heading h2 {
        margin: 0;
        font-size: 24px;
    }

    .hero-side p,
    .reports-heading p,
    .report-meta,
    .report-empty,
    .notice-copy {
        color: var(--wsu-muted);
    }

    .notice-card {
        border-radius: 16px;
        padding: 16px;
        background: linear-gradient(180deg, rgba(152,30,50,0.08), rgba(152,30,50,0.02));
        border: 1px solid rgba(152,30,50,0.14);
    }

    .notice-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(152,30,50,0.12);
        color: var(--wsu-crimson);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .audit-form {
        padding: 28px;
        margin-bottom: 22px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        font-weight: 700;
        margin-bottom: 8px;
        color: var(--wsu-ink);
    }

    input[type="text"],
    input[type="number"],
    select,
    textarea {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid var(--wsu-border);
        border-radius: 14px;
        font-size: 15px;
        background: #fffdfb;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

    input[type="text"]:focus,
    input[type="number"]:focus,
    select:focus,
    textarea:focus {
        outline: none;
        border-color: var(--wsu-crimson);
        box-shadow: 0 0 0 4px rgba(152, 30, 50, 0.12);
        transform: translateY(-1px);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .run-controls {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
    }

    .run-button {
        min-width: 190px;
        padding: 15px 24px;
        font-size: 15px;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    .run-button:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: 0 18px 30px rgba(31,35,41,0.12);
    }

    .run-button:disabled {
        cursor: wait;
        opacity: 0.92;
    }

    .run-button.ready {
        background: linear-gradient(135deg, var(--wsu-crimson), #b3293f);
        color: white;
    }

    .run-button.running {
        background: linear-gradient(135deg, var(--wsu-dark), #58606a);
        color: white;
    }

    .run-button.complete {
        background: linear-gradient(135deg, var(--wsu-success), #279249);
        color: white;
    }

    .run-button.error {
        background: linear-gradient(135deg, var(--wsu-error), #c53b56);
        color: white;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border-radius: 999px;
        background: rgba(53, 93, 140, 0.1);
        color: var(--wsu-info);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .status-panel {
        padding: 24px;
        margin-bottom: 22px;
    }

    .status-box {
        background: linear-gradient(180deg, #faf7f4, #f6f1ec);
        border: 1px solid var(--wsu-border);
        border-radius: 16px;
        padding: 16px;
        margin-top: 18px;
        min-height: 180px;
        max-height: 420px;
        overflow-y: auto;
        font-family: Consolas, monospace;
        font-size: 12px;
    }

    .status-message {
        margin: 0 0 10px;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid transparent;
    }

    .status-message.success {
        background: rgba(31,122,58,0.08);
        color: var(--wsu-success);
        border-color: rgba(31,122,58,0.16);
    }

    .status-message.error {
        background: rgba(177,30,58,0.08);
        color: var(--wsu-error);
        border-color: rgba(177,30,58,0.16);
    }

    .status-message.info {
        background: rgba(53,93,140,0.08);
        color: var(--wsu-info);
        border-color: rgba(53,93,140,0.16);
    }

    .field-note,
    .input-help,
    .section-note {
        font-size: 13px;
        color: var(--wsu-muted);
        margin-top: 8px;
    }

    .custom-url-group {
        margin-top: 12px;
    }

    .advanced-options {
        background: linear-gradient(180deg, #f9f5f1, #fffdfb);
        padding: 18px;
        border-radius: 18px;
        margin-top: 12px;
        border: 1px solid var(--wsu-border);
    }

    .advanced-options h3 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: 18px;
    }

    .reports-heading {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: end;
        margin-bottom: 16px;
    }

    .reports-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
        gap: 18px;
    }

    .report-card {
        padding: 22px;
        min-height: 230px;
    }

    .report-card h3 {
        margin: 0 0 10px;
        font-size: 18px;
    }

    .report-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 14px;
        padding: 12px 18px;
        background: linear-gradient(135deg, var(--wsu-crimson), #b3293f);
        color: white;
        text-decoration: none;
        border-radius: 999px;
        font-weight: 700;
    }

    .report-link.secondary {
        background: linear-gradient(135deg, var(--wsu-dark), #525963);
    }

    .report-link:hover {
        color: white;
    }

    .report-stats {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 14px;
    }

    .report-stat {
        display: inline-flex;
        align-items: center;
        padding: 8px 10px;
        border-radius: 999px;
        background: #f6f1ec;
        border: 1px solid var(--wsu-border);
        font-size: 12px;
        font-weight: 700;
        color: var(--wsu-muted);
    }

    .report-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 14px;
    }

    .delta-list {
        display: grid;
        gap: 8px;
        margin-top: 14px;
    }

    .delta-item {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        border-radius: 14px;
        background: #faf7f4;
        border: 1px solid #eee3d8;
    }

    .delta-value.positive {
        color: var(--wsu-success);
    }

    .delta-value.negative {
        color: var(--wsu-error);
    }

    .delta-value.neutral {
        color: var(--wsu-muted);
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid white;
        border-radius: 50%;
        width: 18px;
        height: 18px;
        animation: spin 1s linear infinite;
        display: none;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .is-running .spinner {
        display: inline-block;
    }

    .hidden {
        display: none;
    }

    .text-danger {
        color: var(--wsu-error);
        font-size: 13px;
    }

    @@media (max-width: 1024px) {
        .audit-hero,
        .reports-grid,
        .form-row {
            grid-template-columns: 1fr;
        }

        .wsu-g-header {
            flex-direction: column;
            align-items: flex-start;
        }

    }

    @@media (max-width: 640px) {
        .audit-shell {
            padding: 18px 14px 34px;
        }

        .hero-card,
        .hero-side,
        .audit-form,
        .status-panel,
        .report-card {
            border-radius: 18px;
        }

        .wsu-g-header__logo-link {
            align-items: flex-start;
        }

        .wsu-g-header__logo-title {
            font-size: 24px;
        }

        .hero-title {
            font-size: 32px;
            max-width: none;
        }

        .reports-heading {
            display: block;
        }
    }
</style>

