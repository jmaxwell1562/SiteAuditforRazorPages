            </span>
        </a>

        <div class="sticky sidebarHover">
            <button class="stickyHoverButton" style="color:white" data-open="sidebarMessage" aria-controls="sidebarMessage" aria-haspopup="dialog" tabindex="0">Need Help Now?</button>
        </div>
    </header>
</div>

<div class="audit-shell">
    <div class="audit-container">
        <section class="audit-hero">
            <div class="hero-card">
                <div class="hero-eyebrow">Student Affairs Style Scheme</div>
                <h1 class="hero-title">Student-centered <strong>migration audit</strong> workflow.</h1>
                <p class="hero-copy">Use the full-width configuration panel below to compare production and test environments, publish per-run artifacts, and reopen the latest report history for the current site without rerunning the audit.</p>

            </div>

            <aside class="hero-side">
                <h2>Run Guidance</h2>
                <div class="notice-card">
                    <div class="notice-label">Duration Notice</div>
                    <div class="notice-copy">@Model.RunDurationNotice</div>
                </div>
                <div>
                    <div class="status-pill">Report history stays site-specific</div>
                    <p class="section-note">Changing or blurring the Site Name field refreshes only the latest and previous reports for that same site.</p>
                </div>
                <div>
                    <div class="status-pill">Localhost audits supported</div>
                    <p class="section-note">When using <strong>https://localhost:7019/</strong>, the local app must be running and reachable on port 7019.</p>
                </div>
            </aside>
        </section>

        <form method="post" class="audit-form" id="audit-form">
            <h2>Audit Configuration</h2>
            <p class="section-note">Source URL, Test URL, and Site Name are required. Use Entire Umbraco Instance when one audit should compare the same source against multiple sibling sites in a single Umbraco instance.</p>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Config.SiteName">Site Name *</label>
                    <input asp-for="Config.SiteName" placeholder="e.g., Cougar Card, Handbook" autocomplete="off" />
                    <div class="input-help">Used to resolve report history even when saved filenames use spaces, underscores, or hyphens.</div>
                    <span asp-validation-for="Config.SiteName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Config.SourceUrl">Source URL (Production) *</label>
                    <input asp-for="Config.SourceUrl" type="text" placeholder="https://source.wsu.edu" />
                    <div class="input-help">If you omit <strong>https://</strong>, the dashboard will add it automatically for hostnames such as <strong>dining.wsu.edu</strong>.</div>
                    <span asp-validation-for="Config.SourceUrl" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Config.TestUrl">Test URL *</label>
                    <select asp-for="Config.TestUrl" id="Config_TestUrl">
                        <option value="">-- Select Test Environment --</option>
                        @foreach (var url in Model.AvailableTestUrls)
                        {
                            <option value="@url">@url</option>
                        }
                        <option value="@Model.CustomTestUrlOption">Custom URL</option>
                    </select>
                    <div class="form-group custom-url-group @(Model.UsesCustomTestUrl ? string.Empty : "hidden")" id="custom-test-url-group">
                        <label for="CustomTestUrl">Custom Test URL</label>
                        <input id="CustomTestUrl" name="CustomTestUrl" type="text" value="@Model.CustomTestUrl" placeholder="https://custom-test.wsu.edu/" />
                        <div class="input-help">Use a full URL for any environment not listed in the preset dropdown. If you omit <strong>https://</strong>, the dashboard will add it automatically for hostnames.</div>
                    </div>
                    <div class="input-help">Localhost audits ignore local HTTPS certificate errors but still require the app to be reachable.</div>
                    <span asp-validation-for="Config.TestUrl" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Config.TestScope">Test Scope</label>
                    <select asp-for="Config.TestScope" id="Config_TestScope">
                        <option value="single">Single Site</option>
                        <option value="instance">Entire Umbraco Instance</option>
                    </select>
                    <div class="input-help">Use <strong>Single Site</strong> for one source-to-test comparison. Use <strong>Entire Umbraco Instance</strong> to include sibling test sites from the same test instance in one audit report.</div>
                </div>
            </div>

            <div class="form-group" id="source-subdomain-group">
                <label class="checkbox-label" for="Config_SourceIsSubdomain">
                    <input asp-for="Config.SourceIsSubdomain" type="checkbox" />
                    <span>Source is a subdomain mapped under the test URL path</span>
                </label>
                <div class="input-help">Enable this for comparisons like a source subdomain against a test path such as <strong>dev.studentaffairs.wsu.edu/chs</strong>, so the test path prefix is preserved for every audited page.</div>
            </div>

            <div class="advanced-options">
                <h3>Optional Scope And Path Controls</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Config.MaxPaths">Max Paths (0 = all)</label>
                        <input asp-for="Config.MaxPaths" type="number" min="0" value="0" />
                    </div>

                    <div class="form-group">
                        <label asp-for="Config.MaxTabs">Max Concurrent Tabs</label>
                        <input asp-for="Config.MaxTabs" type="number" min="1" max="20" value="5" />
                    </div>
                </div>

                <div class="form-group @(Model.Config.TestScope == "instance" ? string.Empty : "hidden")" id="allowlist-group">
                    <label asp-for="Config.TestAllowlist">Test Allowlist</label>
                    <textarea asp-for="Config.TestAllowlist" rows="3" placeholder="chs, camp, https://w3-testing.asis.wsu.edu/aea/hep/"></textarea>
                    <div class="input-help">Optional. Enter comma-separated sibling labels or full URLs to include additional sites from the same test instance in this audit.</div>
                </div>

                <div class="form-group @(Model.Config.TestScope == "instance" ? string.Empty : "hidden")" id="allowlist-file-group">
                    <label asp-for="Config.TestAllowlistFile">Test Allowlist File</label>
                    <input asp-for="Config.TestAllowlistFile" placeholder="path/to/test-sites-allowlist.txt" />
                    <div class="input-help">Optional. Use one label or full URL per line. Blank lines and lines starting with <strong>#</strong> are ignored.</div>
                </div>

                <div class="form-group">
                    <label asp-for="Config.RedirectOverridePaths">Intentional Redirect Paths (comma-separated)</label>
                    <input asp-for="Config.RedirectOverridePaths" placeholder="/path1, /path2" />
                    <div class="input-help">Optional. Use this only for source paths that are expected to redirect on the test site and should be reported as intentional redirects instead of failures. This does not remap one URL to another.</div>
                </div>
            </div>

            <div class="run-controls">
                <button type="submit" asp-page-handler="StartAudit" class="run-button @(Model.RunButtonState.ToLowerInvariant())" id="run-button" data-ready-text="Ready" data-running-text="Running" data-complete-text="Complete" data-error-text="Error">
                    <span class="spinner" id="run-spinner"></span>
                    <span id="btn-text">@Model.RunButtonState</span>
                </button>
                <div>
                    <div class="status-pill" id="run-state-pill">@Model.RunButtonState</div>
                    <div class="field-note">@Model.RunDurationNotice</div>
                </div>
            </div>
            <div class="status-message info hidden" id="run-feedback" role="status" aria-live="polite"></div>
        </form>

        <section id="reports-section" class="@(hasReports ? string.Empty : "hidden")">
            <div class="reports-heading">
                <div>
                    <h2>Generated Reports</h2>
                    <p>Latest published report artifacts for the current site. Desktop keeps both sections in a single row and mobile stacks them vertically.</p>
                </div>
                <div class="status-pill" id="report-site-pill">@(latestReport?.SiteName ?? "No site selected")</div>
            </div>

            <div class="reports-grid">
                <article class="report-card" id="latest-report-card">
                    <h3>New Report</h3>
                    <p class="report-empty @(hasReports ? "hidden" : string.Empty)" id="latest-report-empty">No completed report is available yet for this site.</p>
                    <div class="report-body @(hasReports ? string.Empty : "hidden")" id="latest-report-body">
                        <div class="report-meta" id="latest-report-time">@(latestReport?.GeneratedAtDisplay ?? string.Empty)</div>
                        <div class="report-actions">
                            <a class="report-link" id="latest-report-link" href="@(latestReport?.HtmlUrl ?? "#")" target="_blank" rel="noreferrer">Open HTML Audit Report</a>
                            <a class="report-link secondary @(string.IsNullOrEmpty(latestReport?.ExecutiveHtmlUrl) ? "hidden" : string.Empty)" id="latest-report-executive" href="@(latestReport?.ExecutiveHtmlUrl ?? "#")" target="_blank" rel="noreferrer">Open Executive Preview</a>
                            <a class="report-link secondary @(string.IsNullOrEmpty(latestReport?.XlsxUrl) ? "hidden" : string.Empty)" id="latest-report-xlsx" href="@(latestReport?.XlsxUrl ?? "#")" target="_blank" rel="noreferrer">Open Excel Workbook</a>
                        </div>
                        <div class="report-stats" id="latest-report-stats">
                            @if (latestReport != null)
                            {
                                <span class="report-stat">PASS @latestReport.PassCount</span>
                                <span class="report-stat">REVIEW @latestReport.ReviewCount</span>
                                <span class="report-stat">FAIL @latestReport.FailCount</span>
                                <span class="report-stat">REDIRECT @latestReport.RedirectCount</span>
                            }
                        </div>
                    </div>
                </article>

                <article class="report-card" id="previous-report-card">
                    <h3>Previous Report</h3>
                    <p class="report-empty @(previousReport != null ? "hidden" : string.Empty)" id="previous-report-empty">No prior report history is available yet for this site.</p>
                    <div class="report-body @(previousReport != null ? string.Empty : "hidden")" id="previous-report-body">
                        <div class="report-meta" id="previous-report-time">@(previousReport?.GeneratedAtDisplay ?? string.Empty)</div>
                        <div class="report-actions">
                            <a class="report-link secondary" id="previous-report-link" href="@(Model.PreviousReport?.HtmlUrl ?? "#")" target="_blank" rel="noreferrer">Open Previous Report</a>
                            <a class="report-link secondary @(Model.PreviousReport != null && !string.IsNullOrEmpty(Model.PreviousReport.ExecutiveHtmlUrl) ? string.Empty : "hidden")" id="previous-report-executive" href="@(Model.PreviousReport?.ExecutiveHtmlUrl ?? "#")" target="_blank" rel="noreferrer">Open Previous Executive Preview</a>
                        </div>
                        <div class="delta-list" id="previous-report-deltas">
                            <div class="delta-item">
                                <span>PASS vs previous</span>
                                <span class="delta-value @(Model.PreviousComparison.PassDelta > 0 ? "positive" : Model.PreviousComparison.PassDelta < 0 ? "negative" : "neutral")">@((Model.PreviousComparison.PassDelta >= 0 ? "+" : string.Empty) + Model.PreviousComparison.PassDelta)</span>
                            </div>
                            <div class="delta-item">
                                <span>REVIEW vs previous</span>
                                <span class="delta-value @(Model.PreviousComparison.ReviewDelta < 0 ? "positive" : Model.PreviousComparison.ReviewDelta > 0 ? "negative" : "neutral")">@((Model.PreviousComparison.ReviewDelta >= 0 ? "+" : string.Empty) + Model.PreviousComparison.ReviewDelta)</span>
                            </div>
                            <div class="delta-item">
                                <span>FAIL vs previous</span>
                                <span class="delta-value @(Model.PreviousComparison.FailDelta < 0 ? "positive" : Model.PreviousComparison.FailDelta > 0 ? "negative" : "neutral")">@((Model.PreviousComparison.FailDelta >= 0 ? "+" : string.Empty) + Model.PreviousComparison.FailDelta)</span>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('audit-form');
            const siteNameInput = document.getElementById('Config_SiteName');
            const sourceUrlInput = document.getElementById('Config_SourceUrl');
            const testUrlSelect = document.getElementById('Config_TestUrl');
            const testScopeSelect = document.getElementById('Config_TestScope');
            const customTestUrlGroup = document.getElementById('custom-test-url-group');
            const customTestUrlInput = document.getElementById('CustomTestUrl');
            const sourceSubdomainGroup = document.getElementById('source-subdomain-group');
            const sourceSubdomainInput = document.getElementById('Config_SourceIsSubdomain');
            const allowlistGroup = document.getElementById('allowlist-group');
            const allowlistFileGroup = document.getElementById('allowlist-file-group');
            const runButton = document.getElementById('run-button');
            const buttonText = document.getElementById('btn-text');
            const runStatePill = document.getElementById('run-state-pill');
            const runFeedback = document.getElementById('run-feedback');
            const reportsSection = document.getElementById('reports-section');
            const reportSitePill = document.getElementById('report-site-pill');
            const customTestUrlOption = '@Model.CustomTestUrlOption';

            function setRunFeedback(message, kind) {
                if (!runFeedback) {
                    return;
                }

                if (!message) {
                    runFeedback.textContent = '';
                    runFeedback.className = 'status-message info hidden';
                    return;
                }

                runFeedback.textContent = message;
                runFeedback.className = 'status-message ' + (kind || 'info');
            }

            function setRunState(state) {
                const normalized = (state || 'Ready').toLowerCase();
                runButton.classList.remove('ready', 'running', 'complete', 'error', 'is-running');
                runButton.classList.add(normalized);

                if (normalized === 'running') {
                    runButton.classList.add('is-running');
                    runButton.disabled = true;
                } else {
                    runButton.disabled = false;
                }

                const textMap = {
                    ready: runButton.dataset.readyText,
                    running: runButton.dataset.runningText,
                    complete: runButton.dataset.completeText,
                    error: runButton.dataset.errorText
                };

                buttonText.textContent = textMap[normalized] || state;
                runStatePill.textContent = state;
            }

            function setLinkState(link, value, hiddenWhenEmpty) {
                if (!link) {
                    return;
                }

                if (value) {
                    link.href = value;
                    link.classList.remove('hidden');
                } else if (hiddenWhenEmpty) {
                    link.classList.add('hidden');
                    link.removeAttribute('href');
                }
            }

            function isInstanceScope() {
                return !!(testScopeSelect && testScopeSelect.value === 'instance');
            }

            function buildStatBadge(label, value) {
                const badge = document.createElement('span');
                badge.className = 'report-stat';
                badge.textContent = label + ' ' + value;
                return badge;
            }

            function buildDeltaRow(label, delta, positiveWhenNegative) {
                const row = document.createElement('div');
                row.className = 'delta-item';

                const name = document.createElement('span');
                name.textContent = label;
                row.appendChild(name);

                const value = document.createElement('span');
                let tone = 'neutral';
                if (delta !== 0) {
                    const isPositive = positiveWhenNegative ? delta < 0 : delta > 0;
                    tone = isPositive ? 'positive' : 'negative';
                }

                value.className = 'delta-value ' + tone;
                value.textContent = (delta >= 0 ? '+' : '') + delta;
                row.appendChild(value);
                return row;
            }

            function syncCustomTestUrlVisibility() {
                const usesCustom = testUrlSelect && testUrlSelect.value === customTestUrlOption;
                customTestUrlGroup.classList.toggle('hidden', !usesCustom);
                customTestUrlInput.required = usesCustom;

                if (!usesCustom) {
                    customTestUrlInput.value = '';
                }
            }

            function syncScopeVisibility() {
                const showInstanceInputs = isInstanceScope();

                if (allowlistGroup) {
                    allowlistGroup.classList.toggle('hidden', !showInstanceInputs);
                }

                if (allowlistFileGroup) {
                    allowlistFileGroup.classList.toggle('hidden', !showInstanceInputs);
                }

                if (sourceSubdomainGroup) {
                    sourceSubdomainGroup.classList.remove('hidden');
                }

                if (sourceSubdomainInput) {
                    sourceSubdomainInput.disabled = false;
                }
            }

            function normalizeUrlInputValue(input) {
                if (!input) {
                    return;
                }

                const rawValue = (input.value || '').trim();
                if (!rawValue || rawValue.includes('://') || rawValue.startsWith('/')) {
                    input.value = rawValue;
                    return;
                }

                const firstSegment = rawValue.split('/')[0];
                const looksLikeHost = firstSegment.includes('.') || firstSegment.includes(':') || firstSegment.toLowerCase() === 'localhost';
                input.value = looksLikeHost ? 'https://' + rawValue : rawValue;
            }

            function renderHistory(payload) {
                const latest = payload && payload.latest;
                const previous = payload && payload.previous;
                const comparison = payload && payload.comparison ? payload.comparison : { passDelta: 0, reviewDelta: 0, failDelta: 0 };
                const hasReports = !!(payload && payload.hasReports && latest);

                reportsSection.classList.toggle('hidden', !hasReports);
                reportSitePill.textContent = hasReports ? latest.siteName : 'No site selected';

                const latestBody = document.getElementById('latest-report-body');
                const latestEmpty = document.getElementById('latest-report-empty');
                const latestTime = document.getElementById('latest-report-time');
                const latestStats = document.getElementById('latest-report-stats');
                setLinkState(document.getElementById('latest-report-link'), hasReports ? latest.htmlUrl : null, false);
                setLinkState(document.getElementById('latest-report-executive'), hasReports ? latest.executiveHtmlUrl : null, true);
                setLinkState(document.getElementById('latest-report-xlsx'), hasReports ? latest.xlsxUrl : null, true);

                latestBody.classList.toggle('hidden', !hasReports);
                latestEmpty.classList.toggle('hidden', hasReports);
                latestTime.textContent = hasReports ? latest.generatedAtDisplay : '';
                latestStats.innerHTML = '';
                if (hasReports) {
                    latestStats.appendChild(buildStatBadge('PASS', latest.passCount));
                    latestStats.appendChild(buildStatBadge('REVIEW', latest.reviewCount));
                    latestStats.appendChild(buildStatBadge('FAIL', latest.failCount));
                    latestStats.appendChild(buildStatBadge('REDIRECT', latest.redirectCount));
                }

                const previousBody = document.getElementById('previous-report-body');
                const previousEmpty = document.getElementById('previous-report-empty');
                const previousTime = document.getElementById('previous-report-time');
                const previousDeltas = document.getElementById('previous-report-deltas');
                const hasPrevious = !!previous;

                previousBody.classList.toggle('hidden', !hasPrevious);
                previousEmpty.classList.toggle('hidden', hasPrevious);
                previousTime.textContent = hasPrevious ? previous.generatedAtDisplay : '';
                setLinkState(document.getElementById('previous-report-link'), hasPrevious ? previous.htmlUrl : null, false);
                setLinkState(document.getElementById('previous-report-executive'), hasPrevious ? previous.executiveHtmlUrl : null, true);

                previousDeltas.innerHTML = '';
                if (hasPrevious) {
                    previousDeltas.appendChild(buildDeltaRow('PASS vs previous', comparison.passDelta, false));
                    previousDeltas.appendChild(buildDeltaRow('REVIEW vs previous', comparison.reviewDelta, true));
                    previousDeltas.appendChild(buildDeltaRow('FAIL vs previous', comparison.failDelta, true));
                }
            }

            async function loadHistoryForSite() {
                const siteName = (siteNameInput.value || '').trim();
                if (!siteName) {
                    renderHistory({ hasReports: false });
                    return;
                }

                try {
                    const response = await fetch(`?handler=ReportHistory&siteName=${encodeURIComponent(siteName)}`);
                    if (!response.ok) {
                        throw new Error('Unable to load report history.');
                    }

                    renderHistory(await response.json());
                } catch (error) {
                    setRunFeedback(error.message, 'error');
                }
            }

            siteNameInput.addEventListener('blur', loadHistoryForSite);
            siteNameInput.addEventListener('change', loadHistoryForSite);
            testUrlSelect.addEventListener('change', syncCustomTestUrlVisibility);
            testScopeSelect.addEventListener('change', function () {
                syncScopeVisibility();
                loadHistoryForSite();
            });
            sourceUrlInput.addEventListener('blur', function () { normalizeUrlInputValue(sourceUrlInput); });
            customTestUrlInput.addEventListener('blur', function () { normalizeUrlInputValue(customTestUrlInput); });

            if ((customTestUrlInput.value || '').trim()) {
                testUrlSelect.value = customTestUrlOption;
            }

            syncCustomTestUrlVisibility();
            syncScopeVisibility();

            form.addEventListener('submit', async function (event) {
                event.preventDefault();
                normalizeUrlInputValue(sourceUrlInput);
                normalizeUrlInputValue(customTestUrlInput);
                const instanceMode = isInstanceScope();
                setRunFeedback((instanceMode ? 'Instance audit request submitted. ' : 'Audit request submitted. ') + '@Model.RunDurationNotice', 'info');

                if (testUrlSelect.value === customTestUrlOption && !(customTestUrlInput.value || '').trim()) {
                    setRunFeedback('Enter a custom Test URL before starting the audit.', 'error');
                    setRunState('Error');
                    window.setTimeout(function () {
                        setRunState('Ready');
                    }, 3200);
                    customTestUrlInput.focus();
                    return;
                }

                setRunState('Running');

                try {
                    const formData = new FormData(form);
                    const response = await fetch('?handler=StartAuditApi', {
                        method: 'POST',
                        body: formData
                    });

                    const payload = await response.json();
                    if (!response.ok || !payload.success) {
                        throw new Error(payload.error || 'Audit failed before report generation completed.');
                    }

                    setRunFeedback('Audit complete. Latest report links are ready below.', 'success');
                    renderHistory(payload);
                    setRunState('Complete');
                    window.setTimeout(function () {
                        setRunState('Ready');
                    }, 2400);
                } catch (error) {
                    setRunFeedback(error.message, 'error');
                    setRunState('Error');
                    window.setTimeout(function () {
                        setRunState('Ready');
                    }, 3200);
                }
            });
        })();
    </script>
}
